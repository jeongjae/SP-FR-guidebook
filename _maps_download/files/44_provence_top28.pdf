   <dc:description>
    <rdf:Alt>
     <rdf:li xml:lang="x-default">The City Walls of the Old Town of Briancon, built by Vauban, are Unesco World Culture Heritage site. Briancon is the highest city in France.</rdf:li>
    </rdf:Alt>
   </dc:description>
