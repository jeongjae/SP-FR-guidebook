{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SP-FR public transit facts",
  "type": "object",
  "required": ["schemaVersion", "regions"],
  "properties": {
    "schemaVersion": {"const": "1.0"},
    "regions": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["recommendation", "howToUse", "exceptions", "itineraryUses", "sources"],
        "properties": {
          "recommendation": {
            "type": "object",
            "required": ["title", "summary"],
            "properties": {
              "title": {"type": "string", "minLength": 1},
              "summary": {"type": "string", "minLength": 1}
            },
            "additionalProperties": false
          },
          "products": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["name", "price", "shared", "airportMetro", "fit"],
              "properties": {
                "name": {"type": "string", "minLength": 1},
                "price": {"type": "string", "minLength": 1},
                "shared": {"type": "boolean"},
                "airportMetro": {"type": "boolean"},
                "fit": {"type": "string", "minLength": 1}
              },
              "additionalProperties": false
            }
          },
          "howToUse": {"type": "array", "minItems": 1, "items": {"type": "string"}},
          "exceptions": {"type": "array", "minItems": 1, "items": {"type": "string"}},
          "itineraryUses": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["day", "label"],
              "properties": {
                "day": {"type": "integer", "minimum": 1, "maximum": 43},
                "label": {"type": "string", "minLength": 1}
              },
              "additionalProperties": false
            }
          },
          "sources": {
            "type": "array", "minItems": 1,
            "items": {
              "type": "object",
              "required": ["label", "url", "verifiedAt", "recheckBy"],
              "properties": {
                "label": {"type": "string"},
                "url": {"type": "string", "pattern": "^https://"},
                "verifiedAt": {"type": "string", "format": "date"},
                "recheckBy": {"type": "string", "format": "date"}
              },
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
