{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SP-FR official tourist overview maps",
  "type": "object",
  "required": ["schemaVersion", "regions"],
  "properties": {
    "schemaVersion": {"const": "1.0"},
    "regions": {
      "type": "object",
      "additionalProperties": {
        "type": "array",
        "minItems": 1,
        "items": {
          "type": "object",
          "required": [
            "slug", "title", "place", "scope", "publisher", "edition", "usage",
            "localPath", "rightsHolder", "license", "redistributionBasis",
            "sourceUrl", "verifiedAt"
          ],
          "properties": {
            "slug": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
            "title": {"type": "string", "minLength": 1},
            "place": {"type": "string", "minLength": 1},
            "scope": {"enum": ["region", "city", "site"]},
            "publisher": {"type": "string", "minLength": 1},
            "edition": {"type": "string", "minLength": 1},
            "usage": {"type": "string", "minLength": 20, "maxLength": 420},
            "localPath": {
              "type": "string",
              "pattern": "^assets/tourist-maps/[a-z-]+/[a-z0-9-]+\\.webp$"
            },
            "rightsHolder": {"type": "string", "minLength": 1},
            "license": {"type": "string", "minLength": 1},
            "redistributionBasis": {"type": "string", "minLength": 20},
            "sourceUrl": {"type": "string", "pattern": "^https://"},
            "verifiedAt": {"type": "string", "format": "date"}
          },
          "additionalProperties": false
        }
      }
    }
  },
  "additionalProperties": false
}
