{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SP-FR official transport resources",
  "type": "object",
  "required": ["schemaVersion", "regions"],
  "properties": {
    "schemaVersion": {"const": "1.0"},
    "regions": {
      "type": "object",
      "additionalProperties": {
        "type": "array",
        "minItems": 1,
        "items": {
          "type": "object",
          "required": ["title", "kind", "edition", "usage", "officialUrl", "verifiedAt", "recheckBy"],
          "properties": {
            "title": {"type": "string", "minLength": 1},
            "kind": {"enum": ["network-map", "area-map", "route-map-page"]},
            "edition": {"type": "string", "minLength": 1},
            "usage": {"type": "string", "minLength": 1, "maxLength": 420},
            "localPath": {"type": "string", "pattern": "^source/ASSETS/transport-guides/[^.].*\\.pdf$"},
            "officialUrl": {"type": "string", "pattern": "^https://"},
            "verifiedAt": {"type": "string", "format": "date"},
            "recheckBy": {"type": "string", "format": "date"}
          },
          "additionalProperties": false
        }
      }
    }
  },
  "additionalProperties": false
}
